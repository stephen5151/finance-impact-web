# 模型 API key 接口 —— 填入后自动启用混合问答，不填则降级到关键词匹配。
# 本地：复制为 .env.local 并填写；线上：在 Vercel 项目 Settings → Environment Variables 配置。

# 必填：填了才启用模型
LLM_API_KEY=

# 可选：anthropic（默认）| openai
# openai 兼容协议同样适用于 DeepSeek、通义千问、智谱 GLM —— 配合 LLM_BASE_URL 使用
LLM_PROVIDER=anthropic

# 可选：默认 anthropic=claude-opus-4-8，openai=gpt-4o-mini
# LLM_MODEL=claude-opus-4-8

# 可选：自定义 API 地址（自部署或第三方 OpenAI 兼容服务）
# 例：DeepSeek -> https://api.deepseek.com/v1/chat/completions
# LLM_BASE_URL=


# ===== 最新动态：自动抓取新闻（B 线）=====
# 三者都配齐后，定时任务才会抓取并发布最新动态；缺任意一项则该区块不显示，页面不报错。

# Blob 存储 token。在 Vercel 项目 Storage 里创建 Blob Store 后会自动注入；
# 本地开发把它复制到这里。
BLOB_READ_WRITE_TOKEN=

# 定时任务密钥。自己设一个随机字符串，Vercel Cron 会自动带上它来鉴权，
# 防止 /api/cron/refresh-news 被公开调用。
CRON_SECRET=

# 可选：RSS 源，逗号分隔。不填则用代码里的默认可信源。
# 只有命中可信源白名单（src/data/news.ts）的条目才会自动发布。
# NEWS_FEEDS=https://www.ftchinese.com/rss/feed,http://www.people.com.cn/rss/finance.xml
